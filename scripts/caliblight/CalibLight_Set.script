# Python program for CCDciel
# see: https://www.ap-i.net/ccdciel/en/documentation/jsonrpc_reference
#
# CalibLight change calibration light on or off
# The first parameter is the light to set: Fil1, Fil2, Fil3 
# The second parameter is the state: 0, 1

from ccdciel import ccdciel
import configparser
import time
import sys
import os

# process parameters
try:
  if len(sys.argv) < 3 :
    raise Exception('Missing parameters')
  cname = sys.argv[1]
  state = int(sys.argv[2])
  if (state<0) or (state>1) :
     raise Exception('Incorrect calibration light state')
  if len(sys.argv) > 3 :
     delay = int(sys.argv[3])
  else:
     delay = 0
except Exception as ex:
  print('Invalid parameters: ',ex)
  sys.exit(1)

# current script directory
scriptdir = os.path.dirname(os.path.abspath(sys.argv[0]))
# read connection from config
try:
  config = configparser.ConfigParser()
  config.read(os.path.join(scriptdir,'CalibLight_config.script'))
  connection=config['settings']['connection']
except Exception as ex:
  print('CalibLight connection setting not found in CalibLight_config')
  sys.exit(1)
  
if connection=='alpaca':
   from alpaca import management
   from alpaca import switch   
   
   def findswitch(swn) :
     sw=-1
     for i in range(calib.MaxSwitch):
        name=calib.GetSwitchName(i)
        if (name==swn):
          sw=i
          break
     return sw         
     
   try:
     server=config['alpaca']['server']
   except Exception as ex:
     print('Server configuration not found. Please run CalibLight_Discovery')
     sys.exit(1)
   try :
       ccdciel('LogMsg','Connecting to CalibLight Alpaca server at '+server)
       calib = switch.Switch(server,0)
       calib.Connected=True

       sw=findswitch(cname)
       if sw>=0 :
         ccdciel('LogMsg','Change CalibLight '+cname+' to '+f"{state}")
         calib.SetSwitchValue(sw,state)
         '''
         if delay>0 :
            ccdciel('LogMsg','Waiting for '+f"{delay}"+' seconds')
            time.sleep(delay)
         else:
            time.sleep(2) # let time for calibrex to reply
         newstate = calib.GetSwitchValue(sw)
         if newstate == state :
            print('Calibration '+cname+'='+f"{state}")
         else:
            print('Error, Calibration not modified.'+'='+f"{newstate}")
            sys.exit(1)
         '''
       else:     
         print('Error, Calibration not found '+cname)
         sys.exit(1) 

   except Exception as ex:
       print('Error: '+type(ex).__name__,'-',ex)
       sys.exit(1)
    
else:
   print('Invalid connection '+connection+' in CalibLight_config. Please run CalibLight_Discovery')
   sys.exit(1)
     
